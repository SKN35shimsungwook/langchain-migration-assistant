# Streamlit Cloud: 앱 설정 → Secrets 에 이 내용을 값만 바꿔 붙여 넣습니다. (내 컴퓨터에서는 .env 를 써도 됨)
# 맨 위 줄들은 환경 변수로도 들어가서 팀 그래프가 그대로 읽습니다.

OPENAI_API_KEY = "sk-..."              # analyzer · rewriter (그래프)
CHROMA_API_KEY = "..."                 # retriever (Chroma Cloud)
CHROMA_TENANT = "..."
CHROMA_DATABASE = "..."

[tidb]                                 # 대화 기록 (없으면 앱 안 SQLite, 재시작하면 사라짐)
host = "gateway01.<region>.prod.aws.tidbcloud.com"
port = 4000
user = "<prefix>.root"
password = "<password>"
database = "langchain_db"
